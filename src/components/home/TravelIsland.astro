---
// TravelIsland（规格 §8.1.6 / §9.1）：全站唯一的暗色块。
// #0a0f1e 底 + 径向天蓝辉光 + 14px 圆角；左文右图（1.2fr | 1fr）：
// eyebrow → 衬线标题 → 描述 → 3 个数字（天蓝）→「打开足迹地图 →」（琥珀色）。
// 右侧为最新旅行封面图，左下角叠一行等宽经纬度。
import type { Trip } from '../../types';
import { getCoverPhoto } from './utils';

interface Props {
  trip: Trip | null;
  stats: { trips: number; countries: number; photos: number };
  /** 最近 3 本相册（在暗岛底部快速跳转） */
  recent?: Trip[];
}
const { trip, stats, recent = [] } = Astro.props;
const cover = trip ? getCoverPhoto(trip) : null;
const numbers = [
  { num: stats.trips, label: '次旅行' },
  { num: stats.countries, label: '个国家' },
  { num: stats.photos, label: '张照片' },
];
---

<section
  class="relative overflow-hidden rounded-[14px] bg-night px-7 py-10 text-[#e6eaf2] sm:px-12 sm:py-14"
  aria-labelledby="travel-island-title"
>
  <!-- 径向天蓝辉光（暗色岛屿的氛围来源） -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(ellipse 70% 60% at 78% 30%, rgba(56,189,248,0.16), transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-14">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sky">Off the Clock</p>
      <h2 id="travel-island-title" class="mt-4 font-serif text-3xl font-bold leading-tight text-white sm:text-4xl">
        不写代码的时候，在路上
      </h2>
      <p class="mt-4 max-w-[48ch] leading-relaxed text-[#e6eaf2]/70">
        旅行是这个站最初的起点。照片按旅行丢进文件夹，构建时自动点亮地图——每一次出发都会留下一个坐标。
      </p>

      <dl class="mt-8 flex gap-10">
        {
          numbers.map((n) => (
            <div>
              <dd class="font-serif text-3xl font-bold text-sky">{n.num}</dd>
              <dt class="mt-1 text-sm text-[#e6eaf2]/60">{n.label}</dt>
            </div>
          ))
        }
      </dl>

      <a
        href="/travel"
        class="mt-9 inline-flex items-center gap-2 font-mono text-sm uppercase tracking-[0.08em] text-amber transition-colors hover:text-white"
      >
        打开足迹地图 →
      </a>
    </div>

    <!-- 右侧：最新旅行封面 + 左下角经纬度 -->
    <div class="relative min-h-[230px] overflow-hidden rounded-[10px]">
      {
        cover && trip ? (
          <img
            src={cover.thumb}
            srcset={`${cover.thumb} 640w, ${trip.cover} ${cover.width}w`}
            sizes="(min-width: 1024px) 420px, 100vw"
            alt={`${trip.title} —— ${trip.place.name}`}
            width={cover.width}
            height={cover.height}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
            style={`background-image:url(${cover.blur});background-size:cover;background-position:center`}
          />
        ) : (
          <div class="absolute inset-0 bg-[#111a30]" />
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-night/80 via-transparent to-transparent" aria-hidden="true">
      </div>
      <p class="meta absolute bottom-3 left-3 normal-case !text-[#e6eaf2]/75">
        {
          trip
            ? `${trip.title} · ${trip.place.lat.toFixed(2)}°N ${trip.place.lng.toFixed(2)}°E`
            : 'NO TRIPS YET'
        }
      </p>
    </div>
  </div>

  {/* 最新 3 本相册快速跳转（暗岛底部） */}
  {
    recent.length > 0 && (
      <div class="relative mt-10 border-t border-white/10 pt-6">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#e6eaf2]/50">Latest Albums</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-3">
          {recent.map((t) => {
            const photo = t.photos.find((p) => p.src === t.cover) ?? t.photos[0];
            return (
              <li>
                <a href={`/travel/${t.id}`} class="group flex items-center gap-3">
                  <span
                    class="block h-12 w-16 shrink-0 overflow-hidden rounded-[4px] bg-cover bg-center bg-[#111a30]"
                    style={photo ? `background-image:url(${photo.blur})` : undefined}
                  >
                    {photo && (
                      <img
                        src={photo.thumb}
                        alt=""
                        width={160}
                        height={120}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    )}
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-medium text-white transition-colors group-hover:text-amber">
                      {t.title}
                    </span>
                    <span class="mt-0.5 block font-mono text-[11px] text-[#e6eaf2]/55">
                      {t.date} · {t.photos.length} 张
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</section>
