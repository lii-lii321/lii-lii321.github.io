---
/**
 * 照片墙（无裁切弹性行式布局）：
 * - 每张照片按真实宽高比展示：不缩放变形、不裁切（条目布局见 PhotoItem）；
 * - 末行不拉伸（脚本把最后一行的 grow 归零），避免残行照片被拉成巨图；
 * - 「查看更多」：默认只展示前 24 张，其余由脚本折叠、按钮展开（无 JS 时全部展示）；
 * - 只加载 640 宽 WebP 缩略图，原图留给灯箱；blur 占位防跳变；
 * - 点击派发 gallery:open 事件，由 Lightbox 岛接收（索引 = 全局顺序，与折叠无关）；
 * - 有子景点清单时按景点分段（锚点序号与 travel/[id] 的 sceneChips 一致）。
 */
import type { Photo } from '../../types';
import PhotoItem from './PhotoItem.astro';
import { groupByScene } from './utils';

interface Props {
  photos: Photo[];
  albumTitle: string;
}

const { photos, albumTitle } = Astro.props;

// 按连续区段分组的子景点；start 是每组首张的全局序号（锚点序号与 travel/[id] 的 sceneChips 一致）
let cursor = 0;
const groups = groupByScene(photos).map((g) => {
  const group = { scene: g.scene, start: cursor, items: g.items };
  cursor += g.items.length;
  return group;
});
const hasScenes = groups.length > 1;
---

<div class="photogrid" data-total={photos.length}>
  {
    hasScenes
      ? groups.map((group, gi) => (
          <section id={`scene-${gi}`} class="mb-10 last:mb-0 scroll-mt-28" aria-label={group.scene ?? albumTitle}>
            {group.scene && (
              <div class="mb-4 flex items-baseline justify-between border-b border-rule pb-2">
                <h3 class="h3">{group.scene}</h3>
                <p class="meta">{group.items.length} 张</p>
              </div>
            )}
            <ul class="jrow">
              {group.items.map((photo, j) => (
                <PhotoItem photo={photo} index={group.start + j} albumTitle={albumTitle} />
              ))}
            </ul>
          </section>
        ))
      : (
          <ul class="jrow">
            {photos.map((photo, index) => (
              <PhotoItem photo={photo} index={index} albumTitle={albumTitle} />
            ))}
          </ul>
        )
  }

  {/* 查看更多：默认只展示前 24 张，脚本折叠余下并接管按钮 */}
  <div class="jrow-more mt-8 hidden text-center">
    <button type="button" class="btn-outline cursor-pointer" data-more-label="查看更多照片">
      查看更多照片
    </button>
  </div>
</div>

<style>
  /* 无裁切弹性行式：--jrow-w 是「单位宽高比」的基准宽度。
   * 条目 flex-grow ∝ 宽高比、flex-basis = 比例 × 基准宽 —— 行内所有条目被等比拉伸，
   * 高度（img 的 width:100% + height:auto，比例来自 width/height 属性）自然一致，内容完整。 */
  .jrow {
    --jrow-w: 150px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .jrow li {
    min-width: 0;
  }
  @media (min-width: 640px) {
    .jrow {
      --jrow-w: 250px;
      gap: 6px;
    }
  }
</style>

<script>
  // 照片墙增强：① 末行 grow 归零（残行不拉伸成巨图）；② 超过 24 张时折叠 + 「查看更多」。
  // 无 JS 时全部照片直接展示（渐进增强）。
  // 折叠计划与计数文案抽在 ./utils（纯函数，tests/gallery-utils.test.ts 覆盖）
  import { planFold, sectionCountText } from './utils';

  const LIMIT = 24;

  function setupGrid(grid: HTMLElement) {
    const uls = Array.from(grid.querySelectorAll<HTMLUListElement>('.jrow'));
    const allLis = uls.flatMap((ul) => Array.from(ul.children) as HTMLLIElement[]);
    if (allLis.length === 0) return;

    // ② 折叠：第 LIMIT 张之后先隐藏（保留 DOM，灯箱索引不变）
    const more = grid.querySelector<HTMLElement>('.jrow-more');
    const btn = more?.querySelector('button');
    // 有子景点分组时 ul 外层是 section（含标题与「N 张」计数）；无分组时为 null
    const sections = uls
      .map((ul) => ul.closest<HTMLElement>('section'))
      .filter((s): s is HTMLElement => s !== null);

    // 分组收束：照片全被折叠的分区整组隐藏（避免「有标题无照片」的空分区、锚点跳到空组）；
    // 部分折叠的把「N 张」改为「已展示 X / 共 N 张」，展开时还原为「N 张」
    function syncSections() {
      for (const section of sections) {
        const lis = Array.from(section.querySelectorAll<HTMLElement>('.jrow > li'));
        const total = lis.length;
        const visible = lis.filter((li) => !li.hidden).length;
        section.hidden = visible === 0;
        const counter = section.querySelector<HTMLElement>('p.meta');
        if (counter) counter.textContent = sectionCountText(total, visible);
      }
    }

    // 展开全部折叠的照片（「查看更多」按钮与子景点锚点 chips 共用），随后恢复分区与行式布局
    const expandAll = () => {
      allLis.forEach((li) => (li.hidden = false));
      more?.classList.add('hidden');
      syncSections();
      relayout();
    };

    // URL 带 #scene-N 直达 / 刷新时，目标分区可能整组在折叠范围之外——命中则本次不折叠，
    // 保证浏览器初始锚点定位能找到目标（点击页面内的子景点 chips 走 expandAll 委托，不受影响）
    const hashTarget = location.hash.startsWith('#scene-')
      ? document.getElementById(location.hash.slice(1))
      : null;
    const hashHitsScene = Boolean(hashTarget && grid.contains(hashTarget));

    if (allLis.length > LIMIT && more && btn && !hashHitsScene) {
      // 折叠计划（纯函数 planFold）：按全局序号截断，每组得到可见数
      const { visiblePerGroup } = planFold(
        uls.map((ul) => ul.children.length),
        LIMIT,
      );
      uls.forEach((ul, gi) => {
        Array.from(ul.children).forEach((li, i) => {
          (li as HTMLElement).hidden = i >= visiblePerGroup[gi];
        });
      });
      more.classList.remove('hidden');
      const remaining = allLis.length - LIMIT;
      const label = btn.dataset.moreLabel ?? '查看更多照片';
      btn.textContent = `${label}（还有 ${remaining} 张）`;
      btn.addEventListener('click', expandAll);
      syncSections();
    }

    // 子景点锚点 chips：目标分区可能初始整组折叠隐藏，点击先展开、浏览器随后照常完成锚点跳转
    document.addEventListener('click', (event) => {
      const anchor =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>('a[href^="#scene-"]')
          : null;
      if (!anchor) return;
      const target = document.getElementById(anchor.hash.slice(1));
      if (!target || !grid.contains(target)) return;
      if (!more || more.classList.contains('hidden')) return; // 未处于折叠态，无需展开
      expandAll();
    });

    // ① 末行 grow 归零：按 offsetTop 分行，仅最后一行还原为自然宽度；
    // 折叠中的条目 display:none、offsetTop 恒为 0，需跳过，否则会被误判成末行
    function relayout() {
      for (const ul of uls) {
        const lis = Array.from(ul.children) as HTMLLIElement[];
        for (const li of lis) {
          if (li.dataset.grow === undefined) li.dataset.grow = li.style.flexGrow;
          li.style.flexGrow = li.dataset.grow;
        }
        const rows: HTMLLIElement[][] = [];
        let row: HTMLLIElement[] = [];
        let top: number | null = null;
        for (const li of lis) {
          if (li.hidden || li.closest('section')?.hidden) continue;
          if (top !== null && li.offsetTop !== top) {
            rows.push(row);
            row = [];
          }
          top = li.offsetTop;
          row.push(li);
        }
        if (row.length) rows.push(row);
        rows[rows.length - 1]?.forEach((li) => (li.style.flexGrow = '0'));
      }
    }

    relayout();
    let timer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(timer);
      timer = setTimeout(relayout, 120);
    });
    window.addEventListener('load', relayout);
  }

  document.querySelectorAll<HTMLElement>('.photogrid').forEach(setupGrid);
</script>

<script>
  // 事件委托：点击任意网格项，向 Lightbox 岛广播打开事件（带打开下标）
  document.addEventListener('click', (event) => {
    const target =
      event.target instanceof Element
        ? event.target.closest<HTMLElement>('[data-gallery-index]')
        : null;
    if (!target) return;

    const index = Number(target.dataset.galleryIndex);
    if (!Number.isInteger(index)) return;

    document.dispatchEvent(
      new CustomEvent('gallery:open', { detail: { index } }),
    );
  });
</script>
