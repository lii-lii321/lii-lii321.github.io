---
// 履历时间线（规格 §8.6.2）：每条 150px|1fr，条目间 1px rule。
// 左：起止年份（衬线）+ 时长（等宽）；右：角色（衬线 H3）+ 公司（accent）+ 描述。
// 每条必须带 ≥2 条量化成果（→ 项目符号）。
export interface TimelineItem {
  start: string;
  end: string;
  duration: string;
  role: string;
  org: string;
  desc: string;
  outcomes: readonly string[];
}
interface Props {
  items: readonly TimelineItem[];
}
const { items } = Astro.props;
---

<ol>
  {
    items.map((item, i) => (
      <li
        class={`grid gap-x-8 gap-y-3 py-9 md:grid-cols-[150px_1fr] ${i < items.length - 1 ? 'border-b border-rule' : ''}`}
      >
        <div>
          <p class="font-serif text-lg font-semibold text-ink">
            {item.start} — {item.end}
          </p>
          <p class="meta mt-1 normal-case">{item.duration}</p>
        </div>
        <div class="min-w-0">
          <h3 class="h3">{item.role}</h3>
          <p class="mt-0.5 text-sm font-medium text-accent">{item.org}</p>
          <p class="mt-3 max-w-[60ch] leading-relaxed text-ink-2">{item.desc}</p>
          <ul class="mt-3 space-y-1.5">
            {item.outcomes.map((o) => (
              <li class="flex gap-2 text-sm leading-relaxed text-ink-2">
                <span class="mt-0.5 shrink-0 font-mono text-accent" aria-hidden="true">
                  →
                </span>
                <span>{o}</span>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>
