---
// 通用筛选 chips（规格 §9.1）：选中态为 --color-ink 实心胶囊。
// 静态站零框架方案：点击切换 active + 按钮组 data-filter-scope 联动
// 容器内 [data-filter-item] 的显隐（值 "all" 显示全部）；
// 配套标记：data-filter-group（条目分组，空组整组隐藏）、
// data-filter-empty（空态提示，条目全隐藏时显示）、data-filter-hide（非「全部」时隐藏，如头条卡）。
interface ChipItem {
  label: string;
  count: number;
  value: string;
}
interface Props {
  /** 筛选作用域：页面内唯一，对应被筛条目容器上的 data-filter-scope 值 */
  scope: string;
  items: readonly ChipItem[];
  /** 默认选中的 value */
  active?: string;
}
const { scope, items, active = 'all' } = Astro.props;
---

<div class="flex flex-wrap gap-2" role="group" aria-label="筛选" data-filter-chips={scope}>
  {
    items.map((item) => (
      <button
        type="button"
        data-filter-value={item.value}
        aria-pressed={item.value === active}
        class="min-h-[44px] cursor-pointer rounded-full border border-rule-2 bg-paper px-4 py-2.5 font-mono text-[11px] tracking-[0.02em] text-ink-2 transition-colors aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper hover:border-ink sm:min-h-0 sm:px-3.5 sm:py-1.5"
      >
        {item.label} {item.count}
      </button>
    ))
  }
</div>

<script>
  // 事件委托：同一份脚本服务页面上的所有 chips 组
  document.addEventListener('click', (event) => {
    const btn = event.target instanceof Element ? event.target.closest('[data-filter-value]') : null;
    if (!btn) return;
    const group = btn.closest('[data-filter-chips]');
    const scope = group?.getAttribute('data-filter-chips');
    if (!group || !scope) return;

    const value = btn.getAttribute('data-filter-value') ?? '';
    for (const b of group.querySelectorAll('[data-filter-value]')) {
      b.setAttribute('aria-pressed', String(b === btn));
    }
    document.querySelectorAll(`[data-filter-item][data-filter-scope="${scope}"]`)?.forEach((el) => {
      // 条目可归属多个筛选项（空格分隔，如 "产品 archived"）
      const values = (el.getAttribute('data-filter-value') ?? '').split(/\s+/);
      const show = value === 'all' || values.includes(value);
      el.toggleAttribute('hidden', !show);
    });
    // 空态与分组收束：
    // - 分组（data-filter-group，如文章年份段）内无可见条目时整组隐藏，避免悬空标题；
    // - 条目全部被筛掉时显示空态提示（data-filter-empty）；
    // - 非「全部」时隐藏不参与筛选的区块（data-filter-hide，如头条大卡）。
    let visible = 0;
    document.querySelectorAll(`[data-filter-item][data-filter-scope="${scope}"]`).forEach((el) => {
      if (!el.hasAttribute('hidden')) visible += 1;
    });
    document.querySelectorAll(`[data-filter-group][data-filter-scope="${scope}"]`).forEach((group) => {
      group.toggleAttribute('hidden', group.querySelector('[data-filter-item]:not([hidden])') === null);
    });
    document.querySelectorAll(`[data-filter-empty][data-filter-scope="${scope}"]`).forEach((el) => {
      el.toggleAttribute('hidden', visible > 0);
    });
    document.querySelectorAll(`[data-filter-hide][data-filter-scope="${scope}"]`).forEach((el) => {
      el.toggleAttribute('hidden', value !== 'all');
    });
  });
</script>
