---
// 行式文章条目（规格 §9.1 PostRow）：博客列表 + 首页「最新文章」复用。
// 网格 150px | 1fr | auto：日期（等宽）| 标题 + 摘要 | 阅读时长 + 分类。
interface Props {
  href: string;
  /** Date 对象或 "YYYY-MM-DD" 字符串 */
  date: Date | string;
  title: string;
  desc?: string;
  readingTime: number;
  category: string;
  dense?: boolean;
}
const { href, date, title, desc, readingTime, category, dense = false } = Astro.props;

const d = typeof date === 'string' ? new Date(`${date}T00:00:00`) : date;
const dateText = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<a
  href={href}
  class={`group grid gap-x-6 gap-y-1 border-b border-rule transition-colors hover:bg-paper-2 sm:grid-cols-[110px_1fr_auto] ${
    dense ? 'py-5' : 'py-[34px] md:py-[38px]'
  }`}
>
  <time datetime={d.toISOString()} class="meta pt-1 normal-case">{dateText}</time>
  <div class="min-w-0">
    <h3 class="font-serif text-[1.15rem] font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
      {title}
    </h3>
    {
      desc && (
        <p class="mt-1.5 max-w-[56ch] text-sm leading-relaxed text-ink-2 max-sm:max-w-none line-clamp-2">
          {desc}
        </p>
      )
    }
  </div>
  <p class="meta flex items-baseline gap-3 pt-1 sm:flex-col sm:items-end sm:gap-1.5">
    <span class="normal-case">{readingTime} 分钟</span>
    <span class="text-accent">{category}</span>
  </p>
</a>
