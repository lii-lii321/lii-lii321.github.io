---
// 单标签文章列表 /tags/[tag]
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/blog/PostRow.astro';
import { readingMinutes, type PostEntry } from '../../components/blog/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) tags.add(t);
  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: PostEntry[];
}
const { tag, posts } = Astro.props;
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`#${tag}`} description={`标签「${tag}」下的全部文章。`}>
  <section class="pt-14">
    <p class="eyebrow">Tag</p>
    <h1 class="h1 mt-4"># {tag}</h1>
    <p class="lede mt-5">
      {sorted.length} 篇文章 · <a href="/tags" class="text-accent underline underline-offset-4">全部标签</a>
    </p>
  </section>

  <section class="mt-8 border-t border-rule pb-[var(--spacing-sec)]">
    {
      sorted.map((post) => (
        <PostRow
          href={`/blog/${post.id}`}
          date={post.data.pubDate}
          title={post.data.title}
          desc={post.data.description}
          readingTime={readingMinutes(post.body)}
          category={post.data.category}
        />
      ))
    }
  </section>
</Base>
