---
// 标签索引 /tags（对标主流博客框架标配）：全部标签 + 文章数，行式排布。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="标签" description="按标签浏览全部文章。">
  <section class="pt-14">
    <p class="eyebrow">Tags</p>
    <h1 class="h1 mt-4">标签</h1>
    <p class="lede mt-5">共 {tags.length} 个标签、{posts.length} 篇文章。</p>
  </section>

  <section class="mt-10 pb-[var(--spacing-sec)]">
    <ul class="flex flex-wrap gap-3">
      {
        tags.map(([tag, count]) => (
          <li>
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="tag-link inline-flex items-baseline gap-2 rounded-full border border-rule-2 bg-paper px-4 py-2"
            >
              <span class="text-sm text-ink"># {tag}</span>
              <span class="meta">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
