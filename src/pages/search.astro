---
// 全站搜索 /search：构建时把博客、项目、相册索引内嵌进页面（零外部请求），
// 客户端做加权子序列匹配，纯原生 JS（对标主流框架的 fuzzy search，去掉词库依赖）。
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { readingMinutes } from '../components/blog/utils';
import type { SearchItem } from '../components/search/utils';
import projectsJson from '../data/projects.json';
import travelsJson from '../data/travels.json';
import type { Project, TravelData } from '../types';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projects = (projectsJson as Project[]).sort((a, b) => a.order - b.order);
const travels = travelsJson as TravelData;

const index: SearchItem[] = [
  ...posts.map((p) => ({
    type: '文章' as const,
    title: p.data.title,
    desc: p.data.description,
    meta: `${p.data.pubDate.getFullYear()}.${String(p.data.pubDate.getMonth() + 1).padStart(2, '0')} · ${p.data.category} · ${readingMinutes(p.body)} 分钟`,
    tags: [p.data.category, ...p.data.tags],
    url: `/blog/${p.id}`,
  })),
  ...projects.map((p) => ({
    type: '项目' as const,
    title: p.title,
    desc: p.summary,
    meta: `${p.year} · ${p.category}`,
    tags: [...p.stack, p.category, p.role],
    url: `/projects/${p.id}`,
  })),
  ...travels.trips.map((t) => ({
    type: '相册' as const,
    title: t.title,
    desc: t.description,
    meta: `${t.date} · ${t.place.province ?? t.place.country} · ${t.photos.length} 张`,
    tags: [...t.tags, t.place.name, t.place.country, ...(t.place.province ? [t.place.province] : [])],
    url: `/travel/${t.id}`,
  })),
];

const serialized = JSON.stringify(index);

// 热门标签（构建时统计，top 8）：空查询时的起手入口，零运行时开销
const tagCounts = new Map<string, number>();
for (const item of index) for (const t of item.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const hotTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([t]) => t);
---

<Base title="搜索" description="搜索全站的文章、项目与相册。">
  <section class="pt-14">
    <p class="eyebrow">Search</p>
    <h1 class="h1 mt-4">搜索</h1>
    <p class="lede mt-5">检索范围：{posts.length} 篇文章 · {projects.length} 个项目 · {travels.trips.length} 本相册。索引在构建时生成，匹配在本地完成——任何页面按 <kbd class="rounded border border-rule-2 bg-paper-2 px-1.5 py-0.5 font-mono text-xs text-ink-2">/</kbd> 即可回到这里。</p>
  </section>

  <section class="mt-10 pb-[var(--spacing-sec)]">
    <!-- 搜索框：journal 风格——只有底部发丝线，聚焦转 accent -->
    <input
      id="search-input"
      type="search"
      placeholder="输入关键词，如：RAG、家教、云南、SM-2……"
      autocomplete="off"
      class="w-full border-0 border-b border-rule-2 bg-transparent px-1 py-3 font-serif text-xl text-ink outline-none transition-colors placeholder:font-sans placeholder:text-base placeholder:text-ink-3 focus:border-accent"
      aria-label="搜索全站"
    />

    <p id="search-stats" class="meta mt-4 normal-case" aria-live="polite"></p>
    <ul id="search-results" class="mt-4 border-t border-rule"></ul>

    <!-- 空查询起手区：最近搜索（localStorage，仅本机）+ 热门标签 -->
    <div id="search-idle" class="mt-8 space-y-6">
      <div id="idle-history" hidden>
        <p class="meta">
          最近搜索
          <button
            type="button"
            id="history-clear"
            class="ml-2 cursor-pointer font-mono text-[11px] text-ink-3 underline underline-offset-2 hover:text-accent"
          >
            清除
          </button>
        </p>
        <ul id="history-chips" class="mt-3 flex flex-wrap gap-2"></ul>
      </div>
      <div>
        <p class="meta">热门标签</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            hotTags.map((t) => (
              <li>
                <button type="button" data-search-term={t} class="chip cursor-pointer hover:border-accent hover:text-accent">
                  #{t}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <template id="search-row">
      <li>
        <a data-row class="group flex items-baseline gap-4 border-b border-rule py-4 transition-colors hover:bg-paper-2">
          <span data-type class="meta w-[40px] shrink-0"></span>
          <span class="min-w-0 flex-1">
            <span data-title class="block truncate text-sm font-medium text-ink group-hover:text-accent"></span>
            <span data-desc class="mt-1 block truncate text-xs text-ink-3"></span>
          </span>
          <span data-meta class="meta hidden shrink-0 sm:block"></span>
        </a>
      </li>
    </template>

    <noscript><p class="mt-6 text-sm text-ink-2">搜索需要启用 JavaScript；也可以从<a class="text-accent underline underline-offset-4" href="/archives">归档</a>或<a class="text-accent underline underline-offset-4" href="/tags">标签</a>浏览。</p></noscript>
  </section>

  <script type="application/json" id="search-index" set:html={serialized} />

  <script>
    // 加权匹配与关键词高亮的纯函数在 ../components/search/utils
    // （tests/search-utils.test.ts 覆盖，含「先转义再替换」的安全顺序约定）。
    // View Transitions 下模块脚本只执行一次：纯 localStorage 逻辑留在顶层，DOM 绑定全部
    // 放进 astro:page-load，对每次换页的新输入框 / 结果列表重新接管
    import { score, buildHighlightPattern, highlight, type SearchItem } from '../components/search/utils';

    // 搜索历史：localStorage 最近 5 条（仅本机，无外传）；读失败按无历史处理
    const HISTORY_KEY = 'search-history';
    const readHistory = (): string[] => {
      try {
        const raw = localStorage.getItem(HISTORY_KEY);
        const arr = raw ? (JSON.parse(raw) as unknown) : [];
        return Array.isArray(arr) ? arr.filter((x): x is string => typeof x === 'string').slice(0, 5) : [];
      } catch {
        return [];
      }
    };
    const writeHistory = (q: string) => {
      const next = [q, ...readHistory().filter((x) => x !== q)].slice(0, 5);
      try {
        localStorage.setItem(HISTORY_KEY, JSON.stringify(next));
      } catch {
        /* 隐私模式等写入失败时静默放弃，不影响搜索 */
      }
    };

    document.addEventListener('astro:page-load', () => {
      const items: SearchItem[] = JSON.parse(document.getElementById('search-index')?.textContent ?? '[]');
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      const list = document.getElementById('search-results');
      const stats = document.getElementById('search-stats');
      const rowTpl = document.getElementById('search-row') as HTMLTemplateElement | null;
      const idle = document.getElementById('search-idle');
      const historyBox = document.getElementById('idle-history');
      const historyList = document.getElementById('history-chips');

      /** 空查询起手区：渲染历史 chips（textContent 防注入），无历史时隐藏该组 */
      const renderIdle = () => {
        if (!historyBox || !historyList) return;
        const history = readHistory();
        historyBox.hidden = history.length === 0;
        historyList.innerHTML = '';
        for (const term of history) {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.searchTerm = term;
          btn.className = 'chip cursor-pointer hover:border-accent hover:text-accent';
          btn.textContent = term;
          li.appendChild(btn);
          historyList.appendChild(li);
        }
      };

      // 历史 / 热门 chips 共用委托：点击 → 填入搜索框重搜（URL 同步由 render 完成）
      idle?.addEventListener('click', (event) => {
        const btn = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-search-term]') : null;
        if (!btn || !input) return;
        input.value = btn.dataset.searchTerm ?? '';
        render();
        input.focus();
      });
      document.getElementById('history-clear')?.addEventListener('click', () => {
        try {
          localStorage.removeItem(HISTORY_KEY);
        } catch {
          /* ignore */
        }
        renderIdle();
      });

      const render = () => {
        if (!input || !list || !stats || !rowTpl) return;
        const q = input.value;
        // URL 同步：搜索词写进地址栏（可分享、可回退）
        history.replaceState(null, '', q.trim() ? `/search?q=${encodeURIComponent(q.trim())}` : '/search');
        if (q.trim().length === 0) {
          list.innerHTML = '';
          stats.textContent = `索引 ${items.length} 条，等待输入。`;
          if (idle) idle.hidden = false;
          renderIdle();
          return;
        }
        const matched = items
          .map((item) => ({ item, s: score(item, q) }))
          .filter((x) => x.s > 0)
          .sort((a, b) => b.s - a.s);
        const hits = matched.slice(0, 12);
        stats.textContent = matched.length > hits.length
          ? `「${q.trim()}」命中 ${matched.length} 条，显示前 ${hits.length} 条`
          : `「${q.trim()}」命中 ${hits.length} 条`;
        list.innerHTML = '';
        // 命中才进历史（避免误击键留下无意义词条）；零结果时保留起手区（历史 + 热门标签）
        if (hits.length > 0) writeHistory(q.trim());
        if (idle) {
          idle.hidden = hits.length > 0;
          if (!idle.hidden) renderIdle();
        }

        // 关键词高亮：先转义再替换（顺序约定见 utils），正则元字符与 HTML 特殊字符都处理
        const pattern = buildHighlightPattern(q);

        for (const { item } of hits) {
          const node = rowTpl.content.cloneNode(true) as DocumentFragment;
          const row = node.querySelector('[data-row]') as HTMLAnchorElement;
          row.href = item.url;
          (node.querySelector('[data-type]') as HTMLElement).textContent = item.type;
          (node.querySelector('[data-title]') as HTMLElement).innerHTML = highlight(item.title, pattern);
          (node.querySelector('[data-desc]') as HTMLElement).innerHTML = highlight(item.desc, pattern);
          (node.querySelector('[data-meta]') as HTMLElement).textContent = item.meta;
          list.appendChild(node);
        }
      };

      input?.addEventListener('input', render);
      // 支持 /search?q=关键词 深链（相册标签等入口会跳转过来）
      const initial = new URLSearchParams(location.search).get('q');
      if (initial && input) {
        input.value = initial;
      }
      render();
    });
  </script>
</Base>
