---
// 项目详情 /projects/[id]（规格 §8.3，固定骨架严格按序）：
// 面包屑 → eyebrow + H1 + standfirst → MetaGrid → 01 问题（+引用块）→ 整宽配图占位
// → 02 做法 → 03 结果指标卡 → 踩过的坑折叠 → Pager 上/下一个。
import Base from '../../layouts/Base.astro';
import { siteConfig } from '../../config/site';
import ProjectMeta from '../../components/project/ProjectMeta.astro';
import projectsJson from '../../data/projects.json';
import type { Project } from '../../types';

export function getStaticPaths() {
  const projects = projectsJson as Project[];
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;

const projects = (projectsJson as Project[]).sort((a, b) => a.order - b.order);
const idx = projects.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? projects[idx - 1] : null;
const next = idx < projects.length - 1 ? projects[idx + 1] : null;
---

<Base title={project.title} description={project.summary} ogImage={project.cover}>
  <!-- 结构化数据：面包屑（规格 §13.4） -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '项目', item: new URL('/projects', Astro.site ?? 'https://lii-lii321.github.io').toString() },
        { '@type': 'ListItem', position: 2, name: project.title },
      ],
    })}
  />

  <article class="pb-[var(--spacing-sec)]">
    <!-- ① 面包屑 -->
    <nav class="meta flex items-center gap-2 pt-10 normal-case" aria-label="面包屑">
      <a href="/projects" class="transition-colors hover:text-accent">项目</a>
      <span aria-hidden="true">/</span>
      <span>{project.category}</span>
      <span aria-hidden="true">/</span>
      <span class="text-ink-2">{project.title}</span>
    </nav>

    <!-- ② eyebrow + H1 + standfirst -->
    <header class="mt-8">
      <p class="eyebrow">{project.year} · {project.role}</p>
      <h1 class="h1 mt-4 max-w-[16ch]">{project.title}</h1>
      <p class="lede mt-6">{project.standfirst}</p>
      {
        project.repoUrl && (
          <div class="mt-7">
            <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-outline">
              在 GitHub 查看源码 ↗
            </a>
          </div>
        )
      }
    </header>

    <!-- ③ MetaGrid 4 列 -->
    <div class="mt-12">
      <ProjectMeta project={project} />
    </div>

    <!-- ④ 01 — 问题 -->
    <section class="mt-[var(--spacing-sec)]" aria-labelledby="problem-title">
      <p class="meta">01</p>
      <h2 id="problem-title" class="h2 mt-2">问题</h2>
      <div class="mt-6 max-w-[68ch] space-y-4 leading-[1.9] text-ink-2">
        {project.problem.map((p) => <p>{p}</p>)}
      </div>
      {
        project.pull && (
          <blockquote class="mt-8 max-w-[56ch] border-l-[3px] border-accent py-1 pl-6">
            <p class="font-serif text-xl italic leading-relaxed text-ink">{project.pull}</p>
          </blockquote>
        )
      }
    </section>

    <!-- ⑤ 整宽封面图：有真实截图用真实截图，否则显示占位块 -->
    <figure class="mt-12">
      {
        project.cover ? (
          <img
            src={project.cover}
            alt={`${project.title} 界面截图`}
            width={1200}
            height={750}
            loading="lazy"
            decoding="async"
            class="aspect-[21/9] w-full rounded-[4px] border border-rule bg-paper-2 object-cover object-top"
          />
        ) : (
          <div
            class="flex aspect-[21/9] items-center justify-center rounded-[4px] border border-rule bg-paper-2"
            role="img"
            aria-label={`${project.title} 截图占位`}
          >
            <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-3">
              Figure · {project.id}
            </span>
          </div>
        )
      }
      <figcaption class="meta mt-3 normal-case">
        {project.title} · 界面截图{project.cover ? '' : '（占位 —— 放入 public/projects/<id>/ 后在 projects.json 配 cover）'}
      </figcaption>
    </figure>

    <!-- ⑤b 截图画廊：真实产品截图 -->
    {
      project.shots && project.shots.length > 0 && (
        <section class="mt-12" aria-label="界面截图">
          <p class="meta">Screens</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {
              project.shots.map((shot) => (
                <figure class="min-w-0">
                  {/* 真实宽高（ingest-shots 入库写回）+ h-auto：按真实比例完整展示不裁切，与照片墙同一哲学 */}
                  <img
                    src={shot.src}
                    alt={`${project.title} · ${shot.caption}`}
                    width={shot.width}
                    height={shot.height}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-auto rounded-[4px] border border-rule bg-paper-2"
                  />
                  <figcaption class="meta mt-2 normal-case">{shot.caption}</figcaption>
                </figure>
              ))
            }
          </div>
        </section>
      )
    }

    <!-- ⑥ 02 — 做法：编号步骤 60px | 1fr -->
    <section class="mt-[var(--spacing-sec)]" aria-labelledby="approach-title">
      <p class="meta">02</p>
      <h2 id="approach-title" class="h2 mt-2">做法</h2>
      <ol class="mt-8 border-t border-rule">
        {
          project.approach.map((step) => (
            <li class="grid gap-x-8 gap-y-2 border-b border-rule py-8 md:grid-cols-[60px_1fr]">
              <span class="font-mono text-sm font-medium tracking-[0.08em] text-accent">{step.n}</span>
              <div>
                <h3 class="h3">{step.title}</h3>
                <p class="mt-2.5 max-w-[68ch] leading-[1.9] text-ink-2">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ⑥b 关键决策：做法背后「为什么选这个而不是那个」 -->
    {
      project.decisions && project.decisions.length > 0 && (
        <section class="mt-14" aria-labelledby="decisions-title">
          <p class="meta">Decisions</p>
          <h2 id="decisions-title" class="h3 mt-2">关键决策</h2>
          <dl class="mt-6 grid gap-x-10 gap-y-7 md:grid-cols-2">
            {project.decisions.map((d) => (
              <div class="border-t border-rule pt-4">
                <dt class="text-[0.95rem] font-semibold leading-snug text-ink">{d.title}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-ink-2">{d.body}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <!-- ⑦ 03 — 结果：悬浮编辑风数字（无卡片容器——墨色顶线 + 大衬线数字，这里的容器是噪音） -->
    <section class="mt-[var(--spacing-sec)]" aria-labelledby="outcome-title">
      <p class="meta">03</p>
      <h2 id="outcome-title" class="h2 mt-2">结果</h2>
      <dl class="mt-8 grid gap-x-10 gap-y-8 border-t border-ink pt-6 md:grid-cols-3">
        {
          project.metrics.map((m) => (
            <div>
              <dd class="font-serif text-[2.6rem] font-bold leading-none text-ink tabular-nums">
                {m.num}
                {m.unit && <small class="ml-1 font-sans text-sm font-normal text-ink-3">{m.unit}</small>}
              </dd>
              <dt class="mt-3 text-sm text-ink-2">{m.label}</dt>
              {m.baseline && <dd class="meta mt-2 normal-case">{m.baseline}</dd>}
            </div>
          ))
        }
      </dl>
      <ul class="mt-8 max-w-[68ch] space-y-2">
        {
          project.outcome.map((o) => (
            <li class="flex gap-2 leading-relaxed text-ink-2">
              <span class="mt-0.5 shrink-0 font-mono text-accent" aria-hidden="true">→</span>
              <span>{o}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ⑧ 踩过的坑：<details> 折叠 -->
    {
      project.pitfalls.length > 0 && (
        <section class="mt-[var(--spacing-sec)]" aria-labelledby="pitfalls-title">
          <p class="meta">04</p>
          <h2 id="pitfalls-title" class="h2 mt-2">踩过的坑</h2>
          <details class="pitfalls group mt-6 max-w-[68ch] rounded-[4px] border border-rule">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 bg-paper-2 px-6 py-4 text-sm font-medium text-ink">
              {project.pitfalls.length} 条经验教训
              <span class="font-mono text-ink-3 group-open:hidden" aria-hidden="true">+</span>
              <span class="hidden font-mono text-ink-3 group-open:inline" aria-hidden="true">−</span>
            </summary>
            <ul class="space-y-4 px-6 py-6">
              {project.pitfalls.map((pit) => (
                <li class="flex gap-2.5 text-sm leading-[1.85] text-ink-2">
                  <span class="mt-0.5 shrink-0 font-mono text-accent" aria-hidden="true">→</span>
                  <span>{pit}</span>
                </li>
              ))}
            </ul>
          </details>
        </section>
      )
    }

    <!-- 收尾 CTA：源码 / 联系 -->
    <section class="mt-[var(--spacing-sec)]">
      <div class="flex flex-col items-start justify-between gap-6 rounded-[14px] border border-rule bg-paper-2 px-8 py-10 sm:flex-row sm:items-center">
        <div>
          <h2 class="h3">对 {project.title} 感兴趣？</h2>
          <p class="mt-2 text-sm text-ink-2">
            {project.repoUrl ? '源码完全开源，欢迎提 Issue 与 PR；' : ''}想聊聊实现细节或合作，直接发邮件。
          </p>
        </div>
        <div class="flex shrink-0 gap-3">
          {
            project.repoUrl && (
              <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
                查看源码 ↗
              </a>
            )
          }
          <a href={`mailto:${siteConfig.email}?subject=关于项目：${encodeURIComponent(project.title)}`} class="btn-outline">
            发邮件聊聊
          </a>
        </div>
      </div>
    </section>

    <!-- ⑨ Pager：上一个 / 下一个 -->
    <nav class="mt-[var(--spacing-sec)] grid border-t border-rule sm:grid-cols-2 sm:divide-x sm:divide-rule" aria-label="上一篇 / 下一篇">
      {
        prev ? (
          <a href={`/projects/${prev.id}`} class="group py-8 sm:pr-8">
            <p class="meta">← 上一个</p>
            <p class="h3 mt-2 transition-colors group-hover:text-accent">{prev.title}</p>
          </a>
        ) : (
          <div class="py-8 sm:pr-8" />
        )
      }
      {
        next && (
          <a href={`/projects/${next.id}`} class="group py-8 sm:pl-8 sm:text-right">
            <p class="meta">下一个 →</p>
            <p class="h3 mt-2 transition-colors group-hover:text-accent">{next.title}</p>
          </a>
        )
      }
    </nav>
  </article>
</Base>
