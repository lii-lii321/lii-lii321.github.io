---
// 全站基础布局：浅色编辑 / 杂志风。
// 导航 5 入口 + 右侧 CTA（GitHub / Email / 简历 PDF），当前页 2px accent 下划线；
// 页脚 4 列 + 底栏（版权 / 构建说明 / 最后更新 / RSS）。
// 移动端（≤768px，Tailwind md 断点）链接收进汉堡下滑面板。
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import projectsJson from '../data/projects.json';
import travelsJson from '../data/travels.json';
import type { Project, TravelData } from '../types';

interface Props {
  /** 页面名：用于标题模板「{page} · {name} · {tagline}」；首页不传 */
  title?: string;
  description?: string;
  /** 覆盖当前高亮的导航项（href），默认按 URL 自动判断 */
  active?: string;
  /** OG 类型：文章页传 article，其余默认 website */
  ogType?: 'website' | 'article';
  /** 分享图路径（站内绝对路径，如 /photos/yunnan/01.jpg）；缺省用全站默认图 */
  ogImage?: string;
}

const { title, description = siteConfig.tagline, active, ogType = 'website', ogImage: ogImageProp } = Astro.props;

const fullTitle = title
  ? `${title} · ${siteConfig.name} · ${siteConfig.tagline}`
  : `${siteConfig.name} · ${siteConfig.tagline}`;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (active) return active === href;
  if (href === '/') return path === '/';
  return path.startsWith(href);
};

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/projects', label: '项目' },
  { href: '/blog', label: '文章' },
  { href: '/about', label: '关于' },
  { href: '/travel', label: '旅行' },
];

const year = new Date().getFullYear();

// Ctrl+K 命令面板的紧凑索引：构建期生成、全站内联（约 3KB）。
// 只含标题/类型/URL/日期的快速导航层；全文检索走 /search 的完整索引——快速直达与深度搜索分工。
const palettePosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const paletteProjects = (projectsJson as Project[]).sort((a, b) => a.order - b.order);
const paletteTravels = (travelsJson as TravelData).trips;
const paletteIndex = [
  ...palettePosts.map((p) => ({
    t: p.data.title,
    u: `/blog/${p.id}/`,
    k: '文章',
    d: p.data.pubDate.toISOString().slice(0, 10),
  })),
  ...paletteProjects.map((p) => ({ t: p.title, u: `/projects/${p.id}/`, k: '项目' })),
  ...paletteTravels.map((t) => ({ t: t.title, u: `/travel/${t.id}/`, k: '相册', d: t.date })),
  { t: '全部相册', u: '/travel/', k: '页面' },
  { t: '全部文章', u: '/blog/', k: '页面' },
  { t: '全部项目', u: '/projects/', k: '页面' },
  { t: '关于我', u: '/about/', k: '页面' },
  { t: '中文简历', u: '/resume/', k: '页面' },
  { t: '现在进展', u: '/now/', k: '页面' },
  { t: '深度搜索', u: '/search/', k: '页面' },
];
const paletteJson = JSON.stringify(paletteIndex).replace(/</g, '\\u003c');

// canonical 与 OG 绝对链接依赖 astro.config 的 site（已上线域名 lii-lii321.github.io）
const site = Astro.site ?? new URL('https://lii-lii321.github.io');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(ogImageProp ?? '/og-default.png', site);
// og:image:alt 描述分享图内容；页面标题是最贴近的可用文案（首页用 tagline）
const ogImageAlt = title ?? siteConfig.tagline;
// 首页 WebSite + SearchAction 结构化数据：搜索页启动时读取 ?q=（search.astro），
// 深链真实可用，搜索引擎才有资格在结果里挂站内搜索框
const homeJsonLd =
  path === '/'
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteConfig.name,
        alternateName: siteConfig.enName,
        url: site.href,
        description: siteConfig.tagline,
        inLanguage: 'zh-CN',
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: new URL('/search?q={search_term_string}', site).href,
          },
          'query-input': 'required name=search_term_string',
        },
      }).replace(/</g, '\\u003c')
    : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <ClientRouter />
    <!-- Speculation Rules：悬停/按下时对同站链接预渲染（Chrome 121+，其余浏览器静默忽略）。
         moderate 档 = 指针按下或悬停 >200ms 才预渲染，不会盲目烧流量 -->
    <script is:inline type="speculationrules">
      {
        "prefetch": [
          { "source": "document", "where": { "href_matches": "/*" }, "eagerness": "conservative" }
        ],
        "prerender": [
          {
            "source": "document",
            "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/*.{png,jpg,jpeg,webp,xml,txt,pdf,webmanifest}" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FBFAF7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={fullTitle} href={new URL('/rss.xml', site)} />
    <!-- OG / Twitter card -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {homeJsonLd && <script type="application/ld+json" set:html={homeJsonLd} />}
    <title>{fullTitle}</title>
  </head>

  <body class="flex min-h-screen flex-col bg-paper font-sans text-ink antialiased">
    <!-- 无障碍：跳过导航直达主内容 -->
    <a
      href="#main"
      class="sr-only z-[100] rounded-[4px] bg-ink px-4 py-2 text-sm text-paper focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      跳到主内容
    </a>
    <!-- 顶部导航：姓名（衬线）+ 拼音（等宽）｜ 5 入口 ｜ GitHub / Email / 简历 PDF，底部 1px rule -->
    <header class="sticky top-0 z-50 border-b border-rule bg-paper/90 backdrop-blur">
      <nav class="wrap flex h-16 items-center justify-between gap-6" aria-label="主导航">
        <!-- 品牌区 -->
        <a href="/" class="group flex items-baseline gap-2 whitespace-nowrap">
          <span class="font-serif text-lg font-bold tracking-wide text-ink group-hover:text-accent">
            {siteConfig.name}
          </span>
          <span class="meta hidden sm:inline">{siteConfig.enName}</span>
        </a>

        <!-- 桌面端链接 -->
        <ul class="nav-links hidden items-center gap-7 md:flex">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class="nav-link relative pb-1 text-sm text-ink-2 transition-colors hover:text-ink aria-[current=page]:text-ink"
                >
                  {link.label}
                  {isActive(link.href) && (
                    <span class="absolute inset-x-0 -bottom-[21px] h-0.5 bg-accent" aria-hidden="true" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- 右侧 CTA：移动端只保留简历按钮 -->
        <div class="hidden items-center gap-4 md:flex">
          <a
            href={siteConfig.github}
            target="_blank"
            rel="noopener noreferrer"
            class="meta transition-colors hover:text-ink"
          >
            GitHub ↗
          </a>
          <a href={`mailto:${siteConfig.email}`} class="meta transition-colors hover:text-ink">
            Email
          </a>
          <a href="/resume" class="chip !border-ink !text-ink hover:!border-accent hover:!text-accent">
            简历
          </a>
        </div>

        <!-- 移动端汉堡按钮 -->
        <button
          type="button"
          id="nav-toggle"
          class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
          aria-expanded="false"
          aria-controls="nav-panel"
          aria-label="打开菜单"
        >
          <span class="h-px w-5 bg-ink transition-[transform,opacity]" aria-hidden="true"></span>
          <span class="h-px w-5 bg-ink transition-[transform,opacity]" aria-hidden="true"></span>
          <span class="h-px w-5 bg-ink transition-[transform,opacity]" aria-hidden="true"></span>
        </button>
      </nav>

      <!-- 移动端下滑面板 -->
      <div id="nav-panel" hidden class="nav-panel border-t border-rule bg-paper md:hidden">
        <ul class="wrap flex flex-col py-2">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class="block border-b border-rule py-3 text-sm text-ink-2 aria-[current=page]:font-medium aria-[current=page]:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="flex items-center gap-5 py-4">
            <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="meta flex min-h-[44px] items-center">GitHub ↗</a>
            <a href={`mailto:${siteConfig.email}`} class="meta flex min-h-[44px] items-center">Email</a>
            <a href="/resume" class="chip !border-ink !text-ink ml-auto">简历</a>
          </li>
        </ul>
      </div>
    </header>

    <!-- 页面主体（id="main" 供无障碍跳转链接落点，tabindex="-1" 使跳转后焦点可落在主内容） -->
    <main id="main" tabindex="-1" class="wrap w-full flex-1">
      <slot />
    </main>

    <!-- 页脚：顶部 1px ink 粗线 + 4 列 + 底栏 -->
    <footer class="mt-[var(--spacing-sec)]">
      <div class="border-t border-ink">
        <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
          <!-- 品牌 -->
          <div>
            <p class="font-serif text-xl font-bold">{siteConfig.name}</p>
            <p class="mt-3 max-w-[26ch] text-sm leading-relaxed text-ink-2">
              {siteConfig.title}。{siteConfig.tagline}
            </p>
            <p class="mt-4 flex items-center gap-2 text-sm text-ink-2">
              <span class="pulse inline-block h-1.5 w-1.5 rounded-full bg-ok" aria-hidden="true"></span>
              {siteConfig.availability}
            </p>
          </div>
          <!-- 站点：入口多（9 个），列内用双列网格保持四列高度均衡 -->
          <nav aria-label="站点">
            <p class="meta">站点</p>
            <ul class="mt-4 grid grid-cols-2 gap-x-5 gap-y-2.5 text-sm">
              {
                navLinks.map((link) => (
                  <li>
                    <a href={link.href} class="text-ink-2 transition-colors hover:text-accent">
                      {link.label}
                    </a>
                  </li>
                ))
              }
              <li>
                <a href="/archives" class="text-ink-2 transition-colors hover:text-accent">归档</a>
              </li>
              <li>
                <a href="/tags" class="text-ink-2 transition-colors hover:text-accent">标签</a>
              </li>
              <li>
                <a href="/search" title="快捷键：Ctrl+K" class="text-ink-2 transition-colors hover:text-accent">搜索</a>
              </li>
              <li>
                <a href="/now" class="text-ink-2 transition-colors hover:text-accent">Now</a>
              </li>
            </ul>
          </nav>
          <!-- 项目 -->
          <nav aria-label="项目">
            <p class="meta">项目</p>
            <ul class="mt-4 space-y-2.5 text-sm">
              <li><a href="/projects" class="text-ink-2 transition-colors hover:text-accent">全部项目</a></li>
              <li><a href="/projects/math-tutor-rag" class="text-ink-2 transition-colors hover:text-accent">Math_Tutor_RAG</a></li>
              <li><a href="/projects/smart-tutor" class="text-ink-2 transition-colors hover:text-accent">smart_tutor</a></li>
              <li><a href="/projects/research-lab" class="text-ink-2 transition-colors hover:text-accent">research-lab</a></li>
              <li><a href="/projects/travel-atlas" class="text-ink-2 transition-colors hover:text-accent">Traveling 足迹地图</a></li>
            </ul>
          </nav>
          <!-- 联系 -->
          <div>
            <p class="meta">联系</p>
            <ul class="mt-4 space-y-2.5 text-sm">
              <li>
                <a
                  href={siteConfig.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink-2 transition-colors hover:text-accent"
                >
                  GitHub ↗
                </a>
              </li>
              <li>
                <a href={`mailto:${siteConfig.email}`} class="text-ink-2 transition-colors hover:text-accent">
                  {siteConfig.email}
                </a>
              </li>
              <li>
                <a href="/resume" class="text-ink-2 transition-colors hover:text-accent">
                  简历（中文 / PDF）
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- 底栏 -->
        <div class="border-t border-rule">
          <div class="wrap flex flex-wrap items-center gap-x-6 gap-y-2 py-5">
            <p class="meta normal-case">© {year} {siteConfig.name}</p>
            <p class="meta normal-case">本站用 Astro 构建</p>
            <p class="meta normal-case">最后更新 {siteConfig.updatedAt}</p>
            <a href="/rss.xml" class="meta normal-case transition-colors hover:text-accent">RSS</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // 汉堡菜单：≤900px 时展开 / 收起下滑面板。
      // View Transitions 下模块脚本只执行一次：元素绑定放进 astro:page-load 对每次换页的新 DOM 重做
      document.addEventListener('astro:page-load', () => {
        const toggle = document.getElementById('nav-toggle');
        const panel = document.getElementById('nav-panel');
        if (!toggle || !panel) return;
        toggle.addEventListener('click', () => {
          const open = panel.hidden;
          panel.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
        });
      });
    </script>
    <script>
      // Esc 关闭移动菜单（模块层只挂一次，元素按页实时重查）：收起 + 焦点归还汉堡按钮
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const toggle = document.getElementById('nav-toggle');
        const panel = document.getElementById('nav-panel');
        if (!toggle || !panel || toggle.getAttribute('aria-expanded') !== 'true') return;
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', '打开菜单');
        toggle.focus();
      });
    </script>
    <!-- 返回顶部：滚动超过一屏后浮现 -->
    <button
      type="button"
      id="back-to-top"
      class="fixed bottom-6 right-6 z-40 hidden h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-rule-2 bg-paper text-ink-2 shadow-[0_1px_2px_rgba(20,20,25,0.05),0_10px_30px_rgba(20,20,25,0.08)] transition-colors hover:border-accent hover:text-accent"
      aria-label="返回顶部"
    >
      ↑
    </button>

    <!-- 快捷键速查面板（? 键） -->
    <div
      id="keys-dialog"
      class="fixed inset-0 z-[110] hidden bg-night/40 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-label="快捷键速查"
    >
      <div class="mx-auto mt-[18vh] w-[min(420px,92vw)] rounded-[14px] border border-rule bg-paper px-6 py-5 shadow-2xl">
        <p class="eyebrow">Keyboard</p>
        <h2 class="h3 mt-1">快捷键</h2>
        <dl class="mt-4 space-y-2.5 text-sm text-ink-2">
          <div class="flex justify-between gap-6"><dt>命令面板</dt><dd class="font-mono">Ctrl / ⌘ + K</dd></div>
          <div class="flex justify-between gap-6"><dt>深度搜索</dt><dd class="font-mono">/</dd></div>
          <div class="flex justify-between gap-6"><dt>灯箱切换</dt><dd class="font-mono">← / →</dd></div>
          <div class="flex justify-between gap-6"><dt>灯箱缩放</dt><dd class="font-mono">双击 / 捏合</dd></div>
          <div class="flex justify-between gap-6"><dt>关闭 / 返回</dt><dd class="font-mono">Esc</dd></div>
          <div class="flex justify-between gap-6"><dt>本速查</dt><dd class="font-mono">?</dd></div>
        </dl>
        <button type="button" id="keys-close" class="btn-outline mt-5 w-full">关闭（Esc）</button>
      </div>
    </div>

    <!-- 命令面板（Ctrl / ⌘ + K）：构建期紧凑索引 + 即时筛选 + 键盘导航 -->
    <div
      id="cmdk"
      class="fixed inset-0 z-[110] hidden bg-night/40 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-label="命令面板"
    >
      <div id="cmdk-panel" class="mx-auto mt-[12vh] w-[min(560px,92vw)] overflow-hidden rounded-[14px] border border-rule bg-paper shadow-2xl">
        <input
          id="cmdk-input"
          type="text"
          placeholder="文章 / 项目 / 相册 / 页面…"
          aria-label="快速导航"
          autocomplete="off"
          spellcheck="false"
          class="w-full border-b border-rule bg-transparent px-5 py-4 text-sm text-ink outline-none placeholder:text-ink-3"
        />
        <ul id="cmdk-list" class="max-h-[46vh] overflow-y-auto py-2" role="listbox" aria-label="结果"></ul>
        <p class="meta flex items-center gap-4 border-t border-rule px-5 py-2.5 normal-case">
          <span>↑↓ 选择</span><span aria-hidden="true">·</span>
          <span>↵ 打开</span><span aria-hidden="true">·</span>
          <span>Esc 关闭</span>
          <a href="/search/" class="ml-auto transition-colors hover:text-accent">深度搜索 →</a>
        </p>
      </div>
    </div>
    <script type="application/json" id="cmdk-data" set:html={paletteJson} />

    <script>
      // 键盘中枢（模块只执行一次，DOM 每次导航重建、元素用时现查）：
      // / 深度搜索页 · Ctrl/⌘+K 命令面板 · ? 快捷键速查 · Esc 关闭面板。
      // 灯箱等其他对话框内不抢占（除 Esc/面板内部按键）。
      type PaletteItem = { t: string; u: string; k: string; d?: string };
      const PALETTE_ITEMS: PaletteItem[] = JSON.parse(
        document.getElementById('cmdk-data')?.textContent ?? '[]',
      );
      const KIND_ICON: Record<string, string> = { 文章: '📄', 项目: '🧩', 相册: '📷', 页面: '🧭' };
      let filtered: PaletteItem[] = [];
      let sel = 0;

      const cmdkRoot = () => document.getElementById('cmdk');
      const keysRoot = () => document.getElementById('keys-dialog');
      const cmdkIsOpen = () => cmdkRoot()?.classList.contains('hidden') === false;
      const keysIsOpen = () => keysRoot()?.classList.contains('hidden') === false;

      const lockScroll = () => {
        document.body.style.overflow = 'hidden';
      };
      const unlockScroll = () => {
        if (!cmdkIsOpen() && !keysIsOpen()) document.body.style.overflow = '';
      };

      const cmdkOpen = () => {
        const root = cmdkRoot();
        const inputEl = document.getElementById('cmdk-input') as HTMLInputElement | null;
        if (!root || !inputEl) return;
        root.classList.remove('hidden');
        lockScroll();
        renderPalette();
        inputEl.focus();
      };
      const cmdkClose = () => {
        cmdkRoot()?.classList.add('hidden');
        unlockScroll();
      };

      const keysToggle = () => {
        keysRoot()?.classList.toggle('hidden');
        unlockScroll();
      };

      const paletteScore = (it: PaletteItem, q: string) => {
        const t = it.t.toLowerCase();
        if (t.startsWith(q)) return 100;
        if (t.includes(q)) return 80 - t.indexOf(q);
        if ((it.d ?? '').toLowerCase().includes(q)) return 40;
        if (it.k.toLowerCase().includes(q)) return 30;
        return -1;
      };

      const renderPalette = () => {
        const listEl = document.getElementById('cmdk-list');
        const inputEl = document.getElementById('cmdk-input') as HTMLInputElement | null;
        if (!listEl || !inputEl) return;
        const q = inputEl.value.trim().toLowerCase();
        filtered = PALETTE_ITEMS.map((it) => ({ it, s: q ? paletteScore(it, q) : 50 }))
          .filter((x) => x.s >= 0)
          .sort((a, b) => b.s - a.s || a.it.t.localeCompare(b.it.t))
          .slice(0, 9)
          .map((x) => x.it);
        sel = 0;
        if (filtered.length === 0) {
          const empty = document.createElement('li');
          empty.className = 'px-5 py-6 text-center text-sm text-ink-3';
          empty.textContent = q ? '没有匹配项——回车去深度搜索' : '输入以筛选文章 / 项目 / 相册';
          listEl.replaceChildren(empty);
          return;
        }
        listEl.replaceChildren(
          ...filtered.map((it, r) => {
            const li = document.createElement('li');
            li.setAttribute('role', 'option');
            li.setAttribute('aria-selected', String(r === sel));
            const a = document.createElement('a');
            a.href = it.u;
            if (r === sel) a.classList.add('cmdk-sel');
            const icon = document.createElement('span');
            icon.className = 'cmdk-icon';
            icon.textContent = KIND_ICON[it.k] ?? '•';
            icon.setAttribute('aria-hidden', 'true');
            const title = document.createElement('span');
            title.className = 'cmdk-title';
            title.textContent = it.t;
            const meta = document.createElement('span');
            meta.className = 'cmdk-meta';
            meta.textContent = [it.d, it.k].filter(Boolean).join(' · ');
            a.append(icon, title, meta);
            li.append(a);
            return li;
          }),
        );
      };

      const paletteMove = (delta: number) => {
        if (filtered.length === 0) return;
        sel = (sel + delta + filtered.length) % filtered.length;
        const rows = document.getElementById('cmdk-list')?.querySelectorAll('[role="option"]') ?? [];
        rows.forEach((li, i) => {
          li.setAttribute('aria-selected', String(i === sel));
          li.querySelector('a')?.classList.toggle('cmdk-sel', i === sel);
        });
        rows[sel]?.scrollIntoView({ block: 'nearest' });
      };

      const paletteGo = () => {
        if (filtered.length === 0) {
          const q = (document.getElementById('cmdk-input') as HTMLInputElement | null)?.value.trim();
          location.href = q ? `/search?q=${encodeURIComponent(q)}` : '/search/';
          return;
        }
        document
          .getElementById('cmdk-list')
          ?.querySelectorAll('[role="option"]')
          [sel]?.querySelector('a')
          ?.click(); // 走锚点点击，ClientRouter 会接管为 SPA 导航
      };

      addEventListener('keydown', (event) => {
        const meta = event.ctrlKey || event.metaKey;
        // 面板打开时优先消费内部按键
        if (cmdkIsOpen()) {
          if (event.key === 'Escape') {
            event.preventDefault();
            cmdkClose();
            return;
          }
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            paletteMove(1);
            return;
          }
          if (event.key === 'ArrowUp') {
            event.preventDefault();
            paletteMove(-1);
            return;
          }
          if (event.key === 'Enter') {
            event.preventDefault();
            paletteGo();
            return;
          }
        }
        if (keysIsOpen() && (event.key === 'Escape' || event.key === '?')) {
          event.preventDefault();
          keysToggle();
          return;
        }
        if (meta && (event.key === 'k' || event.key === 'K')) {
          event.preventDefault();
          if (cmdkIsOpen()) cmdkClose();
          else {
            const target = event.target as HTMLElement | null;
            if (target?.closest?.('[role="dialog"]')) return; // 灯箱内不抢占
            cmdkOpen();
          }
          return;
        }
        const inField = (() => {
          const target = event.target as HTMLElement | null;
          return Boolean(
            target &&
              (target.tagName === 'INPUT' ||
                target.tagName === 'TEXTAREA' ||
                target.isContentEditable),
          );
        })();
        if (event.key === '?' && !inField) {
          const target = event.target as HTMLElement | null;
          if (event.defaultPrevented || target?.closest?.('[role="dialog"]')) return;
          event.preventDefault();
          keysToggle();
          return;
        }
        // / 深度搜索（输入框内不触发；已在 /search 时聚焦输入框）
        if (event.key === '/' && !meta && !event.ctrlKey && !event.altKey && !inField) {
          const target = event.target as HTMLElement | null;
          if (event.defaultPrevented || target?.closest?.('[role="dialog"]')) return;
          event.preventDefault();
          if (location.pathname.startsWith('/search')) {
            const input = document.getElementById('search-input') as HTMLInputElement | null;
            input?.focus();
            input?.select();
          } else {
            location.href = '/search';
          }
        }
      });

      // 面板交互：输入筛选、点条目导航（after-swap 统一收尾）、点遮罩关闭
      document.addEventListener('input', (event) => {
        if ((event.target as HTMLElement).id === 'cmdk-input') renderPalette();
      });
      document.addEventListener('click', (event) => {
        if (cmdkIsOpen() && event.target === cmdkRoot()) cmdkClose();
        if (keysIsOpen() && event.target === keysRoot()) keysToggle();
        if ((event.target as HTMLElement).id === 'keys-close') keysToggle();
        const item = event.target instanceof Element ? event.target.closest('#cmdk-list a') : null;
        if (item) cmdkClose();
      });
      document.addEventListener('astro:after-swap', () => {
        cmdkRoot()?.classList.add('hidden');
        keysRoot()?.classList.add('hidden');
        document.body.style.overflow = '';
      });
    </script>

    <script>
      // 返回顶部：滚动超过一屏后浮现。滚动监听全局只挂一次（内部按页重查按钮），按钮点击按页重绑
      let topTicking = false;
      const updateTopBtn = () => {
        topTicking = false;
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        btn.style.display = document.documentElement.scrollTop > window.innerHeight ? 'flex' : 'none';
      };
      addEventListener(
        'scroll',
        () => {
          if (!topTicking) {
            topTicking = true;
            requestAnimationFrame(updateTopBtn);
          }
        },
        { passive: true },
      );
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        // 系统开启「减少动态」时降级为瞬时跳转（CSS 动画见 global.css 的 reduced-motion 块）
        btn.addEventListener('click', () =>
          scrollTo({
            top: 0,
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          }),
        );
        updateTopBtn();
      });
    </script>

    <script>
      // 交互增强（astro:page-load 每页重挂，元素级监听不累积）：
      // ① 数字带 count-up：进入视口从 0 滚到目标值（无 JS / reduced-motion 时显示原值）
      // ② 拍立得 3D 视差：pointer:fine 且允许动效时，鼠标跟随轻微倾斜
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      const countupIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            countupIo.unobserve(entry.target);
            const el = entry.target as HTMLElement;
            const target = Number(el.dataset.countup);
            if (!Number.isFinite(target) || matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
            const duration = 1100;
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / duration);
              el.textContent = String(Math.round(target * easeOut(t)));
              if (t < 1) requestAnimationFrame(tick);
            };
            el.textContent = '0';
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.4 },
      );
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => countupIo.observe(el));
      });

      // 拍立得 3D 视差：仅精确指针（鼠标/触控板）且允许动效；离开时回到初始 2° 旋转
      document.addEventListener('astro:page-load', () => {
        if (!matchMedia('(pointer: fine)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
          const base = 'perspective(900px) rotate(2deg)';
          const onMove = (e: PointerEvent) => {
            const rect = el.getBoundingClientRect();
            const px = (e.clientX - rect.left) / rect.width - 0.5;
            const py = (e.clientY - rect.top) / rect.height - 0.5;
            el.style.transform = `${base} rotateX(${(-py * 10).toFixed(2)}deg) rotateY(${(px * 12).toFixed(2)}deg) rotate(0deg) translateZ(6px)`;
          };
          const onLeave = () => {
            el.style.transform = base;
          };
          el.addEventListener('pointermove', onMove);
          el.addEventListener('pointerleave', onLeave);
        });
      });
    </script>

    <script>
      // 滚动进场：IO 观察 data-reveal 元素，进入视口加 .revealed（样式在 global.css）。
      // 隐藏态样式挂在 html.js-reveal 作用域下——无 JS 时内容直接可见，reduced-motion 时媒体查询豁免
      document.documentElement.classList.add('js-reveal');
      const revealIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              revealIo.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.08 },
      );
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('[data-reveal]:not(.revealed)').forEach((el) => revealIo.observe(el));
      });
    </script>

    <script>
      // 懒加载图片淡入：load 事件不冒泡，用捕获层全局监听一次；
      // 已在缓存中的图（complete）在换页时直接补 .img-loaded
      document.addEventListener(
        'load',
        (e) => {
          const t = e.target as HTMLElement | null;
          if (t && t.tagName === 'IMG' && t.hasAttribute('data-fade')) t.classList.add('img-loaded');
        },
        true,
      );
      document.addEventListener('astro:page-load', () => {
        document
          .querySelectorAll<HTMLImageElement>('img[data-fade]')
          .forEach((img) => img.complete && img.classList.add('img-loaded'));
      });
    </script>

    <script>
      // 相册页景点侧导航：多分组相册右侧圆点导航，滚动时当前景点高亮、点击直达。
      // 仅当页面存在子景点分组（#scene-N 区块）时挂载；IO 追踪当前组（复用 Toc 的观察模式）
      const navDots = () => {
        document.getElementById('scene-dot-nav')?.remove();
        const first = document.getElementById('scene-0');
        if (!first) return;
        const nav = document.createElement('nav');
        nav.id = 'scene-dot-nav';
        nav.className = 'fixed right-4 top-1/2 z-40 -translate-y-1/2 flex-col gap-2.5 md:flex';
        nav.setAttribute('aria-label', '景点快速导航');
        const total = document.querySelectorAll<HTMLElement>('[id^="scene-"][data-scene-nav]').length;
        if (total === 0) return;
        for (let i = 0; i < total; i++) {
          const dot = document.createElement('a');
          dot.href = `#scene-${i}`;
          dot.className = 'scene-dot block h-2.5 w-2.5 rounded-full border border-rule-2 bg-paper-2 transition-all';
          dot.setAttribute('aria-label', `跳到第 ${i + 1} 个景点`);
          nav.appendChild(dot);
        }
        document.body.appendChild(nav);
        const sections = Array.from({ length: total }, (_, i) => document.getElementById(`scene-${i}`)).filter(
          (el): el is HTMLElement => el !== null,
        );
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const idx = sections.indexOf(entry.target as HTMLElement);
              nav.querySelectorAll('.scene-dot').forEach((d, di) => {
                d.classList.toggle('bg-accent', di === idx);
                d.classList.toggle('border-accent', di === idx);
                d.classList.toggle('scale-125', di === idx);
              });
            }
          },
          { rootMargin: '-40% 0px -40% 0px' },
        );
        sections.forEach((s) => io.observe(s));
      };
      document.addEventListener('astro:page-load', navDots);
    </script>
  </body>
</html>
